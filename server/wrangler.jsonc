// テクノ☆ビンゴ — wrangler 設定
// 参照: docs/05_ARCHITECTURE_DESIGN.md（Worker 1 本で静的配信＋API＋Durable Object）
//
// 公開（管理者の許可を取ってから）：
//   cd server && npx wrangler deploy
//   ※ v05 で KV → Durable Object へ移行した。初回の deploy で下の migrations が適用される。
//   ※ 旧 KV 名前空間 BINGO はもう使わない。deploy が通って動作を確認したあと
//      `npx wrangler kv namespace list` で確認して削除してよい（中身はテストデータのみ）。
// ローカル確認は npx wrangler dev（DO もローカルで動く）
{
  "name": "techno-bingo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",

  // client/public をそのまま配る（ビルド無し）。
  // /        → index.html（参加者）
  // /host    → host.html（ホスト・html_handling の既定で拡張子なしでも届く）
  // /api/*   → アセットに無いので Worker 本体が受ける
  "assets": {
    "directory": "../client/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // "none" ＝ アセットに無いパスは Worker 本体へ落とす（/api/* をここで飲み込ませない）
    "not_found_handling": "none"
  },

  // ゲーム 1 つ＝DO 1 個。単一インスタンスなので、どの colo から読んでも必ず最新（強整合）。
  // KV は結果整合で、別 colo の携帯が最大 60 秒古い値を読む（v04 までの遅れの原因）。
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "BingoGame" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BingoGame"] }
  ],

  "observability": { "enabled": true }
}
